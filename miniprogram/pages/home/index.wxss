.search-entry {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 22rpx 28rpx;
  background: #fff;
  border-radius: 40rpx;
}
.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}
.search-placeholder {
  color: var(--text-sub);
  font-size: 28rpx;
}

.takenout-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff8ec;
  color: #b25e00;
  font-size: 26rpx;
}

.category-card {
  display: flex;
  flex-wrap: wrap;
  margin-top: 0;
  padding: 12rpx 0;
}
.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}
.category-icon {
  font-size: 52rpx;
  margin-bottom: 8rpx;
}
.category-name {
  font-size: 24rpx;
  color: #333;
}

.recent-empty {
  margin-top: 0;
  color: var(--text-sub);
  font-size: 26rpx;
  text-align: center;
}
.list-card {
  padding: 0;
  overflow: hidden;
  margin-top: 0;
}
.item-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}
.empty-step {
  margin-top: 24rpx;
  color: #333;
}
.empty-btn {
  margin-top: 40rpx;
  padding: 20rpx 60rpx;
  display: inline-block;
}
.fab-space {
  height: 200rpx;
}
