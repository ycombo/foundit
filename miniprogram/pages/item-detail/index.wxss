.photo-swiper {
  width: 100%;
  height: 480rpx;
  background: #000;
}
.swiper-photo {
  width: 100%;
  height: 100%;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.item-name {
  font-size: 38rpx;
  font-weight: 600;
}
.meta-row {
  margin-top: 16rpx;
}
.path-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}
.path-label {
  margin-right: 12rpx;
}
.path-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}
.note {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.action-card {
  display: flex;
  justify-content: space-around;
  padding: 28rpx 0;
}
.action {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #333;
}
.action-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.timeline-card {
  margin-top: 0;
  padding-left: 40rpx;
}
.timeline-item {
  position: relative;
  padding: 0 0 32rpx 32rpx;
  border-left: 2rpx solid #e5e5e5;
}
.timeline-item:last-child {
  padding-bottom: 0;
  border-left-color: transparent;
}
.timeline-dot {
  position: absolute;
  left: -10rpx;
  top: 6rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--brand);
}
.dot-warn {
  background: var(--warn);
}
.timeline-action {
  font-size: 28rpx;
  color: #333;
}
.timeline-detail {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
  word-break: break-all;
}
.timeline-time {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}
