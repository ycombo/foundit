.search-bar {
  padding: 20rpx 24rpx;
  background: #fff;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f2f2f2;
  border-radius: 40rpx;
  padding: 14rpx 28rpx;
}
.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.search-clear {
  color: #999;
  padding: 0 8rpx;
}
.list-card {
  padding: 0;
  overflow: hidden;
}
.item-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}
