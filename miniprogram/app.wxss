/* 全局基础样式 */
page {
  background: #f6f6f6;
  font-size: 28rpx;
  color: #333;
  --brand: #07c160;
  --brand-light: #e8f8ef;
  --danger: #fa5151;
  --warn: #ff9f0a;
  --text-sub: #999;
  --divider: #f0f0f0;
}

button {
  background: initial;
}
button:focus {
  outline: 0;
}
button::after {
  border: none;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 列表行 */
.cell {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--divider);
}
.cell:last-child {
  border-bottom: none;
}
.cell-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}
.cell-body {
  flex: 1;
  min-width: 0;
}
.cell-title {
  font-size: 30rpx;
  color: #333;
}
.cell-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cell-arrow {
  color: #c8c8c8;
  font-size: 28rpx;
  margin-left: 12rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--brand-light);
  color: var(--brand);
}
.tag-warn {
  background: #fff3e0;
  color: var(--warn);
}

/* 按钮 */
.btn-primary {
  background: var(--brand);
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn-primary.btn-disabled {
  opacity: 0.5;
}
.btn-plain {
  background: #fff;
  color: #333;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn-danger-text {
  color: var(--danger);
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
}

/* 悬浮添加按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 60rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  z-index: 10;
}

/* 空状态 */
.empty {
  padding: 120rpx 60rpx;
  text-align: center;
  color: var(--text-sub);
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx;
  line-height: 1.6;
}

/* 面包屑路径 */
.breadcrumb {
  font-size: 24rpx;
  color: var(--text-sub);
  padding: 20rpx 24rpx 0;
}

/* 分组标题 */
.section-title {
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 28rpx 24rpx 12rpx;
}
